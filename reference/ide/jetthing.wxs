<?xml version="1.0" encoding="UTF-8"?>
<!--
  Jetthing MSI (WiX Toolset v5). Built by `cargo xtask dist` (installer mode) on
  Windows, which passes:
    Version  numeric product version (from [workspace.package] version)
    Stage    absolute path of dist/jetthing-<version>-windows-<arch>
    Icon     absolute path of assets/icon/jetthing.ico
  The UpgradeCode must never change: MajorUpgrade uses it to replace any
  installed version with this one. See docs/release.md.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Jetthing"
           Manufacturer="Jetthing contributors"
           Version="$(var.Version)"
           UpgradeCode="27A9C881-830C-46BF-A627-D52517FAAF55"
           Scope="perMachine"
           Language="1033">
    <SummaryInformation Description="Jetthing IDE installer" />
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of Jetthing is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="jetthing.ico" SourceFile="$(var.Icon)" />
    <Property Id="ARPPRODUCTICON" Value="jetthing.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/HenrySchwerdt/jetthing" />
    <Property Id="ARPHELPLINK" Value="https://github.com/HenrySchwerdt/jetthing/issues" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Jetthing">
        <Directory Id="LICENSESFOLDER" Name="licenses" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="Jetthing" Level="1">
      <Component Id="JetthingExe" Directory="INSTALLFOLDER">
        <File Id="JetthingExeFile" Source="$(var.Stage)\jetthing.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut"
                    Directory="ProgramMenuFolder"
                    Name="Jetthing"
                    Description="Jetthing IDE"
                    WorkingDirectory="INSTALLFOLDER"
                    Icon="jetthing.ico"
                    Advertise="yes" />
        </File>
      </Component>
      <Component Id="JetthingCli" Directory="INSTALLFOLDER">
        <File Id="JetthingCliFile" Source="$(var.Stage)\jetthing-cli.exe" KeyPath="yes" />
        <!-- `jetthing` and `jetthing-cli` on PATH for new terminals. -->
        <Environment Id="PathEntry" Name="PATH" Value="[INSTALLFOLDER]"
                     Action="set" Part="last" System="yes" Permanent="no" />
      </Component>
      <!-- Tells the self-updater to download the next MSI instead of
           overwriting files under Program Files. -->
      <Component Id="InstallMarker" Directory="INSTALLFOLDER">
        <File Id="InstallMarkerFile" Source="$(var.Stage)\jetthing.install" KeyPath="yes" />
      </Component>
      <Component Id="Readme" Directory="INSTALLFOLDER">
        <File Id="ReadmeFile" Source="$(var.Stage)\README.md" KeyPath="yes" />
      </Component>
      <Component Id="Notice" Directory="INSTALLFOLDER">
        <File Id="NoticeFile" Source="$(var.Stage)\NOTICE-intellij-data.md" KeyPath="yes" />
      </Component>
      <Component Id="InterLicense" Directory="LICENSESFOLDER">
        <File Id="InterLicenseFile" Source="$(var.Stage)\licenses\Inter-OFL.txt" KeyPath="yes" />
      </Component>
      <Component Id="MonoLicense" Directory="LICENSESFOLDER">
        <File Id="MonoLicenseFile" Source="$(var.Stage)\licenses\JetBrainsMono-OFL.txt" KeyPath="yes" />
      </Component>
    </Feature>
  </Package>
</Wix>
